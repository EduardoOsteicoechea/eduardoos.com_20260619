<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RevitHello</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Autodesk.Forge.DesignAutomation.Revit" Version="2027.0.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.0.0" />
  </ItemGroup>
  <Target Name="PackBundle" AfterTargets="Build">
    <ItemGroup>
      <BundleFiles Include="$(TargetDir)RevitHello.dll" />
      <BundleFiles Include="$(TargetDir)DesignAutomationBridge.dll" Condition="Exists('$(TargetDir)DesignAutomationBridge.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(BundleFiles)" DestinationFolder="$(ProjectDir)RevitHello.bundle\Contents" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)RevitHello.addin" DestinationFolder="$(ProjectDir)RevitHello.bundle\Contents" SkipUnchangedFiles="true" />
  </Target>
</Project>
