# Optional systemd unit for Eduardo OS Next backend (staging / secondary port).
# Install via deploy-remote-staging.sh (does NOT replace production units).
# Production uses eduardoos.service on :3000 with APP_DIR/.env only.
#
# PORT=3001 must be set so a leaked ADDR=:3000 in EnvironmentFile cannot steal prod.

[Unit]
Description=Eduardo OS Next backend (staging secondary)
After=network.target
# Intentionally separate from any production eduardoos backend unit.

[Service]
Type=simple
User=@DEPLOY_USER@
WorkingDirectory=@NEXT_DIR@
EnvironmentFile=-@NEXT_DIR@/.env
Environment=PORT=3001
Environment=ADDR=:3001
ExecStart=@NEXT_DIR@/backend/bin/eduardoos-next
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
