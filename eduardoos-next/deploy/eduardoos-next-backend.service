# Optional systemd unit for Eduardo OS Next backend (staging / secondary port).
# Install example (does NOT replace production units):
#   sudo cp eduardoos-next-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now eduardoos-next-backend
#
# Adjust WorkingDirectory, EnvironmentFile, and ExecStart paths for your host.

[Unit]
Description=Eduardo OS Next backend (staging secondary)
After=network.target
# Intentionally separate from any production eduardoos backend unit.

[Service]
Type=simple
WorkingDirectory=/opt/eduardoos-next
EnvironmentFile=-/opt/eduardoos-next/.env
Environment=ADDR=:3001
ExecStart=/opt/eduardoos-next/backend/bin/eduardoos-next
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target