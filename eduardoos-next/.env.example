# Example env for Eduardo OS Next (local only). Never commit real secrets.
ADDR=:3001
# PORT overrides ADDR when set (staging/systemd). Example: PORT=3001
# PORT=3001
JWT_SECRET=change-me
INTERNAL_SERVICE_SECRET=change-me
AWS_REGION=us-east-1
S3_BUCKET=eduardoos20260607
# Homescool learning objects use top-level prefix homeschool/ on S3_BUCKET
# (not under media/). Requires IAM ListBucket prefix + object CRUD on
# arn:aws:s3:::eduardoos20260607/homeschool/* (same creds as media/ifcbim).
S3_BACKEND=memory
DATABASE_BACKEND=memory
DYNAMODB_TABLE_PREFIX=eduardoos
USERS_TABLE=eduardoos_users
EPAMS_BACKEND=memory
EPAMS_TABLE=eduardoos_epams
IFCBIM_BACKEND=memory
IFCBIM_TABLE=eduardoos_ifcbim
# Optional: store IFC object bytes in S3 under ifcbim/ (requires AWS creds).
# Falls back to in-process memory bytes when unset or AWS unavailable.
# IFCBIM_S3_BUCKET=eduardoos20260607
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_ACTIVITY_ID=

# SMTP OTP delivery (parity with production authenticator).
# When SMTP_PASS is empty, OTPs are logged to the process stdout (dev-safe).
SMTP_USER=eduardooost@gmail.com
SMTP_PASS=
# Set to 1 ONLY for local/dev to include "otp" in register/forgot-password JSON.
DEV_RETURN_OTP=0

# Optional DeepSeek key for Instrumentalist analyze/chat (503 without it).
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_EXPERT=deepseek-v4-flash
# Optional override for Instrumentalist .instru bodies (default: S3_BUCKET).
# INSTRUMENTALIST_S3_BUCKET=eduardoos20260607

# PayPal hosted button for subscription checkout (returned on payment intents).
PAYPAL_HOSTED_BUTTON_ID=PLACEHOLDER_HOSTED_BUTTON
# Optional override for checkout form action (default PayPal webscr).
# PAYPAL_CHECKOUT_URL=https://www.paypal.com/cgi-bin/webscr
# Frontend may also set PUBLIC_PAYPAL_HOSTED_BUTTON_ID for button placeholder before intent.