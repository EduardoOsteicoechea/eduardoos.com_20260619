---
/**
 * Shared shell: fonts, theme bootstrap, Header (mobile top bar / desktop left rail),
 * optional AuthGate / requireAuth. Main content offsets via --header_height / --header_width.
 */
import "../styles/global.css";
import { Header } from "../components/Header/Header";
import { AuthGate } from "../components/AuthGate/AuthGate";
import { APP_ROUTES } from "../config/routes";

/** Must match AUTH_TOKEN_KEY in src/lib/auth.ts */
const AUTH_TOKEN_KEY = "eduardoos-next-auth-token";

interface Props {
  title?: string;
  requireAuth?: boolean;
  pageHome?: boolean;
}

const {
  title = "Eduardo OS Next",
  requireAuth = false,
  pageHome = false,
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html
  lang="en"
  class:list={{ "page-home": pageHome }}
  data-auth-check={requireAuth ? "pending" : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Eduardo OS Next — greenfield rebuild of Eduardo Osteicoechea’s AEC platform."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32.png"
    />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" sizes="180x180" />
    <link
      rel="shortcut icon"
      href="/favicon-32.png"
      sizes="32x32"
      type="image/png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Raleway:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {
      requireAuth && (
        <>
          <style is:inline>
            {`html[data-auth-check="pending"] body { visibility: hidden !important; }`}
          </style>
          <script
            is:inline
            define:vars={{ loginPath: APP_ROUTES.login, tokenKey: AUTH_TOKEN_KEY }}
          >
            {`(function () {
  function tokenLooksValid(raw) {
    if (!raw || typeof raw !== "string") return false;
    var parts = raw.split(".");
    if (parts.length < 2) return false;
    try {
      var b64 = parts[1].replace(/-/g, "+").replace(/_/g, "/");
      var pad = (4 - (b64.length % 4)) % 4;
      b64 = b64 + "===".slice(0, pad);
      var payload = JSON.parse(atob(b64));
      if (typeof payload.exp === "number" && Date.now() >= payload.exp * 1000) return false;
      return typeof payload.sub === "string" && payload.sub.trim().length > 0;
    } catch (_) {
      return false;
    }
  }
  try {
    var token = localStorage.getItem(tokenKey);
    if (!tokenLooksValid(token)) {
      try { localStorage.removeItem(tokenKey); } catch (_) {}
      var next = encodeURIComponent(location.pathname + location.search);
      location.replace(loginPath + "?next=" + next);
      return;
    }
  } catch (_) {
    location.replace(loginPath);
    return;
  }
  document.documentElement.setAttribute("data-auth-check", "ok");
})();`}
          </script>
        </>
      )
    }
    <script is:inline>
      (function () {
        try {
          var key = "eduardoos-theme";
          var stored = localStorage.getItem(key);
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
          document.documentElement.classList.toggle("dark", theme === "dark");
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <AuthGate client:load pathname={pathname} />
    <Header client:load pathname={pathname} />
    <main>
      <slot />
    </main>
  </body>
</html>
