---
/**
 * Dedicated shell for the Panfleto editor: site header chrome + full-bleed workspace.
 * Reserves mobile top bar / desktop 60px left rail; avoids BaseLayout <main> sheet fights.
 */
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import "./PamphletLayout.css";
import { Header } from "../components/Header/Header";
import { AuthGate } from "../components/AuthGate/AuthGate";

interface Props {
  title?: string;
}

const { title = "Pamphlet — Eduardo OS Next" } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32.png"
    />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" sizes="180x180" />
    <link
      rel="shortcut icon"
      href="/favicon-32.png"
      sizes="32x32"
      type="image/png"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Raleway:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content="Editor de panfletos — Eduardo OS Next" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var key = "eduardoos-theme";
          var stored = localStorage.getItem(key);
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
          document.documentElement.classList.toggle("dark", theme === "dark");
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="page-pamphlet">
    <AuthGate client:load pathname={pathname} />
    <Header client:load pathname={pathname} />
    <div class="pamphlet-layout-workspace">
      <slot />
    </div>
  </body>
</html>
