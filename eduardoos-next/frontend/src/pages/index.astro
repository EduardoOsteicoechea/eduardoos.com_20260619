---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactAgent from "../components/Contact/ContactAgent";
import { APP_ROUTES, CONTACT_API_ROUTES } from "../config/routes";
---

<BaseLayout title="Eduardo Osteicoechea — Eduardo OS Next" pageHome={true}>
  <div class="page-shell home-hero">
    <div class="home-hero__stage">
      <div class="home-hero__copy">
        <p class="home-hero__brand">Eduardo Osteicoechea</p>
        <h1>AEC Technologist</h1>
        <p class="home-hero__lead">
          Licensed Building Architect, BIM practitioner, and full-stack
          BIM–desktop–web–cloud developer. Eduardo OS Next is the greenfield
          rebuild — production stays live until cutover.
        </p>
        <div class="home-hero__links">
          <a class="btn btn--primary" href={APP_ROUTES.contact}>Contact</a>
          <a class="btn" href={APP_ROUTES.bim}>OpenBIM</a>
          <a class="btn" href={APP_ROUTES.apsAdmin}>APS</a>
        </div>
      </div>
      <aside class="home-hero__chat" aria-label="Assistant">
        <ContactAgent
          client:load
          alwaysShowChat={true}
          showDirectLinks={false}
          scopeId="home"
          title="Assistant"
          askPath={CONTACT_API_ROUTES.profileAsk}
          skillLabel="Home"
          welcomeMessage="Hello — I am Eduardo’s assistant. Confirm you are not a bot below, then ask about his work, skills, or how to get in touch."
        />
      </aside>
    </div>
  </div>
</BaseLayout>
