---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticlesList from "../../components/Articles/ArticlesList";
---

<BaseLayout
  title="Articles — Eduardo Osteicoechea"
  description="Public pamphlets as linear articles. Optimized for readers and AI crawlers (JSON, plain text, semantic HTML)."
>
  <div class="page-shell" data-page="articulos">
    <ArticlesList client:load />
    <noscript>
      <p>
        JavaScript is off. Use the machine-readable index:
        <a href="/api/articles/index.html">/api/articles/index.html</a>
        or <a href="/api/articles">/api/articles</a> (JSON).
      </p>
    </noscript>
  </div>
</BaseLayout>
