---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticlesList from "../../components/Articles/ArticlesList";
---

<BaseLayout
  title="Articles — Eduardo Osteicoechea"
  description="Public pamphlets as linear articles."
>
  <div class="page-shell" data-page="articulos">
    {/* Crawl discovery in static HTML (no JS needed). Clipped visually. */}
    <nav class="articles-crawl-only" aria-hidden="true" data-crawl="articles-static">
      <a href="/api/articles/index.html">Articles HTML index</a>
      <a href="/api/articles">Articles JSON</a>
      <a href="/llms.txt">llms.txt</a>
    </nav>
    <ArticlesList client:load />
  </div>
</BaseLayout>

<style is:global>
  .articles-crawl-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
