---
/**
 * Panfleto editor — dedicated PamphletLayout + client-only mount.
 * Remounts on every Astro page-load so ClientRouter soft navigations work.
 */
import PamphletLayout from "../../layouts/PamphletLayout.astro";
---

<PamphletLayout title="Pamphlet — Eduardo OS Next">
  <div id="pamphlet-root" class="pamphlet-route-root"></div>
</PamphletLayout>

<script>
  import {
    mountPamphletGenerator,
    type PamphletMountHandle,
  } from "../../lib/pamphlet-generator/src/index.ts";
  import { getAuthToken, isApsAdminEmail, getAuthEmailFromToken } from "../../lib/auth";
  import { checkServiceAccess } from "../../lib/payments";
  import { APP_ROUTES } from "../../config/routes";

  let handle: PamphletMountHandle | null = null;

  async function ensureAccess(host: HTMLElement): Promise<boolean> {
    const token = getAuthToken();
    if (!token) {
      host.innerHTML = `<section class="service-gate"><h1 class="service-gate__title">Pamphlet</h1><p class="service-gate__lead">Sign in to use the pamphlet editor.</p><a class="btn btn--primary" href="${APP_ROUTES.login}?next=${encodeURIComponent(APP_ROUTES.pamphlet)}">Sign in</a></section>`;
      return false;
    }
    if (isApsAdminEmail(getAuthEmailFromToken())) return true;
    try {
      const { allowed } = await checkServiceAccess("pamphlet");
      if (allowed) return true;
    } catch {
      /* fall through */
    }
    host.innerHTML = `<section class="service-gate"><h1 class="service-gate__title">Pamphlet</h1><p class="service-gate__lead">This service requires an active subscription.</p><div class="service-gate__actions"><a class="btn btn--primary" href="${APP_ROUTES.subscription}">Subscribe</a></div></section>`;
    return false;
  }

  async function mount() {
    const host = document.getElementById("pamphlet-root");
    if (!host) return;
    handle?.destroy();
    handle = null;
    host.innerHTML = "";
    if (!(await ensureAccess(host))) return;
    handle = mountPamphletGenerator(host);
  }

  function destroy() {
    handle?.destroy();
    handle = null;
  }

  document.addEventListener("astro:page-load", () => {
    void mount();
  });
  document.addEventListener("astro:before-swap", destroy);
  void mount();
</script>
