{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ListMediaPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::eduardoos20260607",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "media/",
            "media/*",
            "ifcbim/",
            "ifcbim/*",
            "homeschool/",
            "homeschool/*",
            "greek/",
            "greek/*",
            "church/",
            "church/*",
            "scrib/",
            "scrib/*",
            "ereport/",
            "ereport/*",
            "agentsandbox/",
            "agentsandbox/*"
          ]
        }
      }
    },
    {
      "Sid": "S3MediaObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::eduardoos20260607/media/*"
    },
    {
      "Sid": "S3IfcBimObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::eduardoos20260607/ifcbim/*"
    },
    {
      "Sid": "S3HomeschoolObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::eduardoos20260607/homeschool/*"
    },
    {
      "Sid": "S3GreekObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::eduardoos20260607/greek/*"
    },
    {
      "Sid": "S3ChurchObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::eduardoos20260607/church/*"
    },
    {
      "Sid": "S3ScribObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::eduardoos20260607/scrib/*"
    },
    {
      "Sid": "S3EreportObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::eduardoos20260607/ereport/*"
    },
    {
      "Sid": "S3AgentSandboxObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::eduardoos20260607/agentsandbox/*"
    },
    {
      "Sid": "S3ListApsBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::aps20250806"
    },
    {
      "Sid": "S3ApsObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::aps20250806/*"
    }
  ]
}
