---
/**
 * Scrollable professional dossier under the home hero.
 * Desktop: lives in home-hero__main (2 of 3 equal columns; agent sticky in col 3).
 */
import {
  PROFILE_EMAIL,
  PROFILE_GITHUB,
  PROFILE_LINKEDIN,
  PROFILE_SITE,
  PROFILE_WHATSAPP,
  PROFILE_WHATSAPP_DISPLAY,
  PROFILE_YOUTUBE,
  profileEducation,
  profileExperience,
  profileExpertiseAnswer,
  profileFaq,
  profileFocusAnswer,
  profileSkillCards,
  profileStack,
  profileWhoAnswer,
} from "../../lib/eduardoProfile";
import "./HomeProfile.css";
---

<section class="home-profile" aria-label="Professional profile">
  <div class="home-profile__inner">
    <header class="home-profile__intro">
      <p class="home-profile__eyebrow">Professional profile</p>
      <p class="home-profile__deck">
        Architect, BIM engineer, and software builder — focused on AI-driven
        tools that make AEC work clearer, faster, and more honest.
      </p>
    </header>

    <div class="home-profile__grid">
      <section class="home-profile__block" id="who">
        <div class="home-profile__heading">
          <span class="material-symbols-outlined" aria-hidden="true">person</span>
          <h2>Profile</h2>
        </div>
        <p class="home-profile__answer">{profileWhoAnswer}</p>
      </section>

      <section class="home-profile__block" id="expertise">
        <div class="home-profile__heading">
          <span class="material-symbols-outlined" aria-hidden="true">architecture</span>
          <h2>Specialization</h2>
        </div>
        <p class="home-profile__answer">{profileExpertiseAnswer}</p>
      </section>

      <section class="home-profile__block home-profile__block--span-2" id="education">
        <div class="home-profile__heading">
          <span class="material-symbols-outlined" aria-hidden="true">school</span>
          <h2>Education and Training</h2>
        </div>
        <p class="home-profile__answer">
          My path combines architecture, BIM specialization, theology study, and
          deliberate full-stack self-training — so I can design buildings and ship
          the software (and AI systems) that support them.
        </p>
        <ul class="home-profile__list home-profile__list--cols">
          {profileEducation.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section
        class="home-profile__block home-profile__block--span-2 home-profile__block--flat"
        id="experience"
      >
        <div class="home-profile__heading">
          <span class="material-symbols-outlined" aria-hidden="true">work</span>
          <h2>Professional Experience</h2>
        </div>
        <p class="home-profile__answer">
          From architectural production and missionary leadership through US BIM
          consulting into AI-powered BIM product engineering at Avant Leap — with
          freelance full-stack delivery in between.
        </p>
        <ol class="home-profile__jobs">
          {
            profileExperience.map((job) => (
              <li class="home-profile__job">
                <div class="home-profile__job-head">
                  <span class="material-symbols-outlined" aria-hidden="true">{job.icon}</span>
                  <h3>
                    <span class="home-profile__org">{job.org}</span>
                    <span class="home-profile__role">{job.role}</span>
                  </h3>
                </div>
                <p class="home-profile__period">{job.period}</p>
                <p>{job.summary}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section
        class="home-profile__block home-profile__block--span-2 home-profile__block--flat"
        id="skills"
      >
        <div class="home-profile__heading">
          <span class="material-symbols-outlined" aria-hidden="true">handyman</span>
          <h2>Skills and Stack</h2>
        </div>
        <p class="home-profile__answer">
          Six strengths I lean on daily — especially where BIM meets AI-driven
          product development.
        </p>
        <ul class="home-profile__skill-grid" aria-label="Skills">
          {
            profileSkillCards.map((s) => (
              <li>
                <div class="home-profile__skill-title">
                  <span class="material-symbols-outlined" aria-hidden="true">{s.icon}</span>
                  <strong>{s.title}</strong>
                </div>
                <span>{s.description}</span>
              </li>
            ))
          }
        </ul>
        <p class="home-profile__stack">
          <strong>Technical stack (representative):</strong>
          {profileStack}
        </p>
      </section>

      <section class="home-profile__block home-profile__block--span-2 home-profile__block--flat" id="faq">
        <div class="home-profile__heading">
          <span class="material-symbols-outlined" aria-hidden="true">help</span>
          <h2>FAQ</h2>
        </div>
        <div class="home-profile__faq-grid">
          {
            profileFaq.map((item) => (
              <article class="home-profile__faq-card">
                <h3>
                  <span class="material-symbols-outlined" aria-hidden="true">{item.icon}</span>
                  <span class="home-profile__faq-q">{item.question}</span>
                </h3>
                {item.answerLinks && item.answerLinks.length > 0 ? (
                  <p class="home-profile__faq-answer home-profile__faq-answer--links">
                    <a href={item.answerLinks[0].href}>{item.answerLinks[0].label}</a>
                    {", "}
                    <a
                      href={item.answerLinks[1].href}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      {item.answerLinks[1].label}
                    </a>
                    {", or "}
                    <a
                      href={item.answerLinks[2].href}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      {item.answerLinks[2].label}
                    </a>
                    .
                  </p>
                ) : (
                  <p class="home-profile__faq-answer">{item.answer}</p>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <section class="home-profile__block" id="focus">
        <div class="home-profile__heading">
          <span class="material-symbols-outlined" aria-hidden="true">track_changes</span>
          <h2>Focus</h2>
        </div>
        <p class="home-profile__answer">{profileFocusAnswer}</p>
      </section>

      <section class="home-profile__block" id="contact-profile">
        <div class="home-profile__heading">
          <span class="material-symbols-outlined" aria-hidden="true">contact_mail</span>
          <h2>Contact</h2>
        </div>
        <p class="home-profile__answer">
          Reach me on the public channels below — email, WhatsApp, or LinkedIn.
          Same canonical contacts across Eduardo OS.
        </p>
        <ul class="home-profile__contacts">
          <li>
            <span class="home-profile__contact-label">LinkedIn</span>
            <a href={PROFILE_LINKEDIN} rel="noopener noreferrer" target="_blank"
              >linkedin.com/in/eduardoosteicoechea</a
            >
          </li>
          <li>
            <span class="home-profile__contact-label">Email</span>
            <a href={`mailto:${PROFILE_EMAIL}`}>{PROFILE_EMAIL}</a>
          </li>
          <li>
            <span class="home-profile__contact-label">WhatsApp</span>
            <a href={PROFILE_WHATSAPP} rel="noopener noreferrer" target="_blank"
              >{PROFILE_WHATSAPP_DISPLAY}</a
            >
          </li>
          <li>
            <span class="home-profile__contact-label">GitHub</span>
            <a href={PROFILE_GITHUB} rel="noopener noreferrer" target="_blank"
              >github.com/EduardoOsteicoechea</a
            >
          </li>
          <li>
            <span class="home-profile__contact-label">YouTube</span>
            <a href={PROFILE_YOUTUBE} rel="noopener noreferrer" target="_blank"
              >youtube.com/@EduardoOsteicoechea</a
            >
          </li>
          <li>
            <span class="home-profile__contact-label">Site</span>
            <a href={PROFILE_SITE}>{PROFILE_SITE.replace("https://", "")}</a>
          </li>
        </ul>
        <p class="home-profile__cta-row">
          <a
            class="btn btn--primary"
            href={PROFILE_LINKEDIN}
            rel="noopener noreferrer"
            target="_blank">View LinkedIn profile</a
          >
          <a class="btn" href="/contact">Contact via Eduardo OS</a>
        </p>
      </section>
    </div>
  </div>
</section>
