---
/**
 * Example Astro route page.
 * 1. Copy `portable/pamphlet-generator` → e.g. `src/lib/pamphlet-generator`
 * 2. Adjust the Layout import to your app
 * 3. Place this file at `src/pages/panfleto.astro` (or any route)
 */
import Layout from "../layouts/Layout.astro";
---

<Layout title="Panfleto">
  <!-- Host mount node: the generator injects its own chrome + sheet inside -->
  <div id="pamphlet-root" class="pamphlet-route-root"></div>
</Layout>

<style is:global>
  /* Give the generator room inside your layout */
  .pamphlet-route-root {
    width: 100%;
    min-height: calc(100vh - 4rem);
  }
</style>

<script>
  import { mountPamphletGenerator } from "../lib/pamphlet-generator/src/index.ts";

  const host = document.getElementById("pamphlet-root");
  if (host) {
    const handle = mountPamphletGenerator(host);

    // Astro View Transitions (optional)
    document.addEventListener("astro:before-swap", () => handle.destroy(), { once: true });
  }
</script>
