---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactAgent from "../components/Contact/ContactAgent";
import HomeProfile from "../components/Home/HomeProfile.astro";
import { APP_ROUTES } from "../config/routes";
import { siteAgentDockProps } from "../lib/agentVoice";
import {
  PROFILE_LINKEDIN,
  buildHomeProfileJsonLd,
  profileWhoAnswer,
} from "../lib/eduardoProfile";

const pageUrl = "https://eduardoos.com/";
const jsonLd = buildHomeProfileJsonLd(pageUrl);
const siteAgent = siteAgentDockProps("home");
---

<BaseLayout
  title="Eduardo Osteicoechea — AEC Technologist"
  description={profileWhoAnswer}
  pageHome={true}
>
  <link slot="head" rel="canonical" href={pageUrl} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="page-shell home-hero">
    <div class="home-hero__stage">
      <div class="home-hero__primary">
        <picture class="home-hero__photo" aria-hidden="true">
          <img
            src="/personal_photo_1080x1920_side_placed.webp"
            alt=""
            width="1080"
            height="1920"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
        <div class="home-hero__copy">
          <p class="home-hero__brand">Eduardo Osteicoechea</p>
          <h1>AEC Technologist</h1>
          <p class="home-hero__lead">
            Licensed Building Architect, BIM practitioner, and full-stack
            BIM–desktop–web–cloud developer. Eduardo OS Next is the greenfield
            rebuild — production stays live until cutover.
          </p>
          <div class="home-hero__links">
            <a class="btn btn--primary" href={APP_ROUTES.contact}>Contact</a>
            <a
              class="btn"
              href={PROFILE_LINKEDIN}
              rel="noopener noreferrer"
              target="_blank">LinkedIn</a
            >
          </div>
        </div>
      </div>
      <aside class="home-hero__chat" aria-label="AI agent">
        <ContactAgent client:load {...siteAgent} />
      </aside>
    </div>

    <HomeProfile />
  </div>
</BaseLayout>
