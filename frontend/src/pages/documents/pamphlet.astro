 * as a full-bleed editor exception under the same Header/rail.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PamphletHub from "../../components/Pamphlet/PamphletHub";
---

<BaseLayout title="Pamphlet — Eduardo Osteicoechea" requireAuth={true}>
  <div class="page-shell page-shell--product" data-page="pamphlet">
    <PamphletHub client:load />
  </div>
</BaseLayout>
