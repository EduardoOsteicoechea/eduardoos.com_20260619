---
/**
 * Panfleto editor — dedicated PamphletLayout + client-only mount.
 */
import PamphletLayout from "../../layouts/PamphletLayout.astro";
---

<PamphletLayout title="Pamphlet — Eduardo Osteicoechea">
  <div id="pamphlet-root" class="pamphlet-route-root"></div>
</PamphletLayout>

<script>
  import { mountPamphletGenerator } from "../../lib/pamphlet-generator/src/index.ts";

  const host = document.getElementById("pamphlet-root");
  if (host) {
    const handle = mountPamphletGenerator(host);
    document.addEventListener(
      "astro:before-swap",
      () => {
        handle.destroy();
      },
      { once: true },
    );
  }
</script>
