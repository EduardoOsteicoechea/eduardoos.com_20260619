---
import { APP_ROUTES } from "../../../../config/routes";

const target = APP_ROUTES.subscription;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Redirecting to subscription…</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>
      Redirecting to <a href={target}>Build your subscription</a>…
    </p>
  </body>
</html>
