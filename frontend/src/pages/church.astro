---
import { CHURCH_FEATURE_ENABLED } from "../lib/churchFeature";
import BaseLayout from "../layouts/BaseLayout.astro";
import ChurchHubPage from "../components/Church/ChurchHubPage";

if (!CHURCH_FEATURE_ENABLED) {
  return Astro.redirect("/");
}
---

<BaseLayout title="Church — Eduardo Osteicoechea">
  <div class="page-shell page-shell--product">
    <ChurchHubPage client:load />
  </div>
</BaseLayout>
