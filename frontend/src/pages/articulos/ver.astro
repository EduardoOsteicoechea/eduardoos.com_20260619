---
/**
 * Legacy /articulos/ver → /dashboard/articulos/ver (spec 051). Preserves ?id=.
 */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <script is:inline>
      (function () {
        var dest =
          "/dashboard/articulos/ver" +
          window.location.search +
          window.location.hash;
        window.location.replace(dest);
      })();
    </script>
    <meta http-equiv="refresh" content="0;url=/dashboard/articulos/ver" />
    <link rel="canonical" href="/dashboard/articulos/ver" />
  </head>
  <body>
    <p><a href="/dashboard/articulos/ver">Article moved — continue</a></p>
  </body>
</html>
