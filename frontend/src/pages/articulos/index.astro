---
/**
 * Legacy /articulos → /dashboard/articulos (spec 051). Preserves query/hash.
 */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <script is:inline>
      (function () {
        var dest =
          "/dashboard/articulos" + window.location.search + window.location.hash;
        window.location.replace(dest);
      })();
    </script>
    <meta http-equiv="refresh" content="0;url=/dashboard/articulos" />
    <link rel="canonical" href="/dashboard/articulos" />
  </head>
  <body>
    <p><a href="/dashboard/articulos">Articles moved — continue</a></p>
  </body>
</html>
