---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticlesList from "../components/Articles/ArticlesList";
---

<BaseLayout title="Artículos — Eduardo Osteicoechea" requireAuth>
  <div class="page-shell" data-page="articulos">
    <ArticlesList client:load />
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var path = location.pathname.replace(/\/$/, "") || "/";
    if (path !== "/articulos") return;
    if (document.querySelector('[data-page="articulos"]')) return;
    location.reload();
  })();
</script>
