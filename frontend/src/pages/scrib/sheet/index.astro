---
/**
 * Scrib sheet editor — BaseLayout chrome + full-bleed canvas (spec 054).
 * Client parses pathname / query and loads the sheet editor.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ScribEditor from "../../../components/Scrib/ScribEditor";
---

<BaseLayout
  title="Scrib sheet — Eduardo Osteicoechea"
  requireAuth={true}
  pageEditorBleed={true}
>
  <div class="page-shell page-shell--product" data-page="scrib-editor">
    <ScribEditor client:only="react" />
  </div>
</BaseLayout>
