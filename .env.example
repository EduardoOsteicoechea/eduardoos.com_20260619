# Copy to .env and fill in secrets.
# Host: `go run ./cmd/eduardoos` + `bash deploy/ec2/build-frontend.sh`
# Docker: nginx + certbot only (mounts ./frontend/dist and proxies /api to host:3000).
JWT_SECRET=change-me-jwt-secret-min-32-chars
INTERNAL_SERVICE_SECRET=change-me-internal-secret-min-32-chars
PORT=3000
SMTP_USER=eduardooost@gmail.com
SMTP_PASS=your-gmail-app-password
DOMAIN=localhost
CERTBOT_EMAIL=eduardooost@gmail.com
PAYPAL_HOSTED_BUTTON_ID=QEVGD66SG7LXN
PAYPAL_BUSINESS_EMAIL=
PAYPAL_CHECKOUT_URL=https://www.paypal.com/cgi-bin/webscr
# Sandbox testing:
# PAYPAL_CHECKOUT_URL=https://www.sandbox.paypal.com/cgi-bin/webscr
# PAYPAL_IPN_VERIFY_URL=https://ipnpb.sandbox.paypal.com/cgi-bin/webscr
PAYPAL_IPN_VERIFY_URL=https://ipnpb.paypal.com/cgi-bin/webscr

# AWS — set real backends on EC2 (see docker-compose.ec2.yml)
AWS_REGION=us-east-1
S3_BUCKET=eduardoos20260607
S3_PREFIX=media
S3_BACKEND=stub
DATABASE_BACKEND=memory
DYNAMODB_TABLE_PREFIX=eduardoos
TELEMETRY_BACKEND=memory
TESTER_BACKEND=memory
PLAYLISTS_BACKEND=memory
PLAYLISTS_TABLE=eduardoos_playlists
PAYMENTS_BACKEND=memory
PAYMENTS_TABLE=eduardoos_payments
ENTITLEMENTS_BACKEND=memory
ENTITLEMENTS_TABLE=eduardoos_entitlements
S3_AUDIO_PREFIX=worship_playlists

# Autodesk Platform Services (Design Automation) — admin UI at /aps-admin
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_ACTIVITY_ID=
APS_INPUT_ARGUMENT=inputFile
APS_INPUT_OBJECT_KEY=singleRoom.rvt
APS_OUTPUT_ARGUMENT=outputFile
APS_OUTPUT_FILE_NAME=result.json
APS_OUTPUT_KEY_PREFIX=aps-outputs
APS_S3_BUCKET=aps20250806
APS_S3_REGION=us-east-1
APS_OAUTH_SCOPE=code:all data:read data:write
